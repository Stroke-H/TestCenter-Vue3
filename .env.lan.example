# Copy this file to `.env.lan.local` once, then keep one stable user-facing
# hostname. Users should always open the same hostname even if this Mac's
# LAN IP changes.
#
# Example:
#
#   cp .env.lan.example .env.lan.local
#
# Keep `.env.lan.local` local-only. It is ignored by git.

# Stable hostname mode. Back this hostname with router DNS, LAN DNS,
# a company DNS record, hosts management, or Bonjour/mDNS if your client
# devices and network reliably support it.
TESTCENTER_LAN_HOST=www.inspdance.com
TESTCENTER_FRONTEND_ORIGIN=http://www.inspdance.com:5173
TESTCENTER_BACKEND_ORIGIN=http://www.inspdance.com:8080

# IP addresses are printed by start.sh only as diagnostics and fallbacks.
# Do not share an IP as the primary address if the goal is a stable entry.
